@page "/humanization"

@using Core.FeatureFlags
@using Core.Humanization

@inject FeatureFlagService featureFlags
@inject HumanizationAdminService humanizationAdmin
@inject FatigueSimulator fatigueSimulator
@inject ScheduledBreakService scheduledBreaks

<PageTitle>Humanization</PageTitle>

<h3>Humanization (Anti-Detection)</h3>

<div class="alert alert-secondary small">
    Humanization is opt-in and disabled by default. Settings persist to <code>runtime_feature_flags.json</code> and apply immediately.
</div>

<Card class="mt-2">
    <CardHeader>Status</CardHeader>
    <CardBody>
        <dl class="row mb-0">
            <dt class="col-sm-4">Enabled</dt>
            <dd class="col-sm-8"><b>@(featureFlags.Current.Humanization.Enabled ? "On" : "Off")</b></dd>

            <dt class="col-sm-4">Session</dt>
            <dd class="col-sm-8">@fatigueSimulator.SessionDuration.ToString(@"hh\:mm\:ss")</dd>

            <dt class="col-sm-4">Fatigue</dt>
            <dd class="col-sm-8">@(((fatigueSimulator.FatigueMultiplier - 1) * 100).ToString("F0"))%</dd>

            <dt class="col-sm-4">On Break</dt>
            <dd class="col-sm-8">
                @if (scheduledBreaks.IsOnBreak)
                {
                    <span>Yes (@scheduledBreaks.RemainingBreakTime.ToString(@"mm\:ss"))</span>
                }
                else
                {
                    <span>No</span>
                }
            </dd>
        </dl>

        <div class="mt-2 d-flex gap-2 flex-wrap">
            <button class="btn btn-sm btn-outline-secondary" @onclick="SkipBreak" disabled="@(!scheduledBreaks.IsOnBreak)">
                Skip Break
            </button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="ResetSession">
                Reset Session
            </button>
        </div>
    </CardBody>
</Card>

<Card class="mt-2">
    <CardHeader>Configuration</CardHeader>
    <CardBody>
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="humEnabled"
                   @bind="enabled" />
            <label class="form-check-label" for="humEnabled">Enable Humanization</label>
        </div>

        <hr class="my-3" />

        <h5>Input Timing</h5>
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Hold Mean (ms)</label>
                <input class="form-control" type="number" @bind="keyHoldMeanMs" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Hold StdDev (ms)</label>
                <input class="form-control" type="number" @bind="keyHoldStdDevMs" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Hold Min (ms)</label>
                <input class="form-control" type="number" @bind="keyHoldMinMs" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Hold Max (ms)</label>
                <input class="form-control" type="number" @bind="keyHoldMaxMs" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Reaction Max (ms)</label>
                <input class="form-control" type="number" @bind="reactionMaxMs" />
            </div>
        </div>

        <hr class="my-3" />

        <h5>Mouse</h5>
        <div class="row g-3">
            <div class="col-md-3">
                <div class="form-check form-switch mt-4">
                    <input class="form-check-input" type="checkbox" role="switch" id="mouseEnabled"
                           @bind="mouseEnabled" />
                    <label class="form-check-label" for="mouseEnabled">Enable Mouse Paths</label>
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label">Steps</label>
                <input class="form-control" type="number" @bind="mouseSteps" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Curve</label>
                <input class="form-control" type="number" step="0.01" @bind="mouseCurveIntensity" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Jitter (px)</label>
                <input class="form-control" type="number" @bind="mouseJitterPixels" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Overshoot (0-1)</label>
                <input class="form-control" type="number" step="0.01" @bind="mouseOvershootProbability" />
            </div>
        </div>

        <hr class="my-3" />

        <h5>Fatigue / Breaks</h5>
        <div class="row g-3">
            <div class="col-md-3">
                <div class="form-check form-switch mt-4">
                    <input class="form-check-input" type="checkbox" role="switch" id="fatigueEnabled"
                           @bind="fatigueEnabled" />
                    <label class="form-check-label" for="fatigueEnabled">Enable Breaks</label>
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label">Break Interval (min)</label>
                <input class="form-control" type="number" @bind="breakIntervalMinutes" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Break Min (min)</label>
                <input class="form-control" type="number" step="0.1" @bind="breakDurationMinMinutes" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Break Max (min)</label>
                <input class="form-control" type="number" step="0.1" @bind="breakDurationMaxMinutes" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Fatigue Rate (/hr)</label>
                <input class="form-control" type="number" step="0.01" @bind="fatigueRatePerHour" />
            </div>
        </div>

        <hr class="my-3" />

        <h5>Micro Pauses</h5>
        <div class="row g-3">
            <div class="col-md-3">
                <div class="form-check form-switch mt-4">
                    <input class="form-check-input" type="checkbox" role="switch" id="microEnabled"
                           @bind="microPauseEnabled" />
                    <label class="form-check-label" for="microEnabled">Enable Micro Pauses</label>
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label">Interval (sec)</label>
                <input class="form-control" type="number" @bind="microPauseIntervalSeconds" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Min (ms)</label>
                <input class="form-control" type="number" @bind="microPauseMinMs" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Max (ms)</label>
                <input class="form-control" type="number" @bind="microPauseMaxMs" />
            </div>
        </div>

        <div class="mt-3 d-flex gap-2 flex-wrap">
            <button class="btn btn-sm btn-primary" @onclick="Save">Save</button>
            <a class="btn btn-sm btn-outline-secondary" href="/Settings">Back to Settings</a>
        </div>

        @if (!string.IsNullOrWhiteSpace(saveStatus))
        {
            <div class="mt-2 text-muted small">@saveStatus</div>
        }
    </CardBody>
</Card>

@code {
    private bool enabled;

    private int keyHoldMeanMs;
    private int keyHoldStdDevMs;
    private int keyHoldMinMs;
    private int keyHoldMaxMs;
    private int reactionMaxMs;

    private bool mouseEnabled;
    private int mouseSteps;
    private double mouseCurveIntensity;
    private int mouseJitterPixels;
    private double mouseOvershootProbability;

    private bool fatigueEnabled;
    private int breakIntervalMinutes;
    private double breakDurationMinMinutes;
    private double breakDurationMaxMinutes;
    private double fatigueRatePerHour;

    private bool microPauseEnabled;
    private int microPauseIntervalSeconds;
    private int microPauseMinMs;
    private int microPauseMaxMs;

    private string saveStatus = string.Empty;

    protected override void OnInitialized()
    {
        HumanizationOptions options = featureFlags.Current.Humanization;

        enabled = options.Enabled;

        keyHoldMeanMs = options.InputTiming.KeyHoldMeanMs;
        keyHoldStdDevMs = options.InputTiming.KeyHoldStdDevMs;
        keyHoldMinMs = options.InputTiming.KeyHoldMinMs;
        keyHoldMaxMs = options.InputTiming.KeyHoldMaxMs;
        reactionMaxMs = options.InputTiming.ReactionMaxMs;

        mouseEnabled = options.MouseMovement.Enabled;
        mouseSteps = options.MouseMovement.StepsPerMovement;
        mouseCurveIntensity = options.MouseMovement.CurveIntensity;
        mouseJitterPixels = options.MouseMovement.MicroJitterPixels;
        mouseOvershootProbability = options.MouseMovement.OvershootProbability;

        fatigueEnabled = options.Fatigue.Enabled;
        breakIntervalMinutes = options.Fatigue.BreakIntervalMinutes;
        breakDurationMinMinutes = options.Fatigue.BreakDurationMinMinutes;
        breakDurationMaxMinutes = options.Fatigue.BreakDurationMaxMinutes;
        fatigueRatePerHour = options.Fatigue.FatigueRatePerHour;

        microPauseEnabled = options.Behavior.MicroPauseEnabled;
        microPauseIntervalSeconds = options.Behavior.MicroPauseIntervalSeconds;
        microPauseMinMs = options.Behavior.MicroPauseMinMs;
        microPauseMaxMs = options.Behavior.MicroPauseMaxMs;
    }

    private Task Save()
    {
        try
        {
            saveStatus = "Saving...";

            humanizationAdmin.Save(new HumanizationOptions
            {
                Enabled = enabled,
                InputTiming = new HumanizationInputTimingOptions
                {
                    KeyHoldMeanMs = keyHoldMeanMs,
                    KeyHoldStdDevMs = keyHoldStdDevMs,
                    KeyHoldMinMs = keyHoldMinMs,
                    KeyHoldMaxMs = keyHoldMaxMs,
                    ReactionMaxMs = reactionMaxMs
                },
                MouseMovement = new HumanizationMouseMovementOptions
                {
                    Enabled = mouseEnabled,
                    StepsPerMovement = mouseSteps,
                    CurveIntensity = mouseCurveIntensity,
                    MicroJitterPixels = mouseJitterPixels,
                    OvershootProbability = mouseOvershootProbability
                },
                Fatigue = new HumanizationFatigueOptions
                {
                    Enabled = fatigueEnabled,
                    BreakIntervalMinutes = breakIntervalMinutes,
                    BreakDurationMinMinutes = breakDurationMinMinutes,
                    BreakDurationMaxMinutes = breakDurationMaxMinutes,
                    FatigueRatePerHour = fatigueRatePerHour
                },
                Behavior = new HumanizationBehaviorOptions
                {
                    MicroPauseEnabled = microPauseEnabled,
                    MicroPauseIntervalSeconds = microPauseIntervalSeconds,
                    MicroPauseMinMs = microPauseMinMs,
                    MicroPauseMaxMs = microPauseMaxMs
                }
            });

            saveStatus = $"Saved. File: {humanizationAdmin.RuntimeFlagsFilePath}";
        }
        catch (Exception ex)
        {
            saveStatus = $"Save failed: {ex.Message}";
        }

        return Task.CompletedTask;
    }

    private Task SkipBreak()
    {
        scheduledBreaks.SkipBreak("UI");
        return Task.CompletedTask;
    }

    private Task ResetSession()
    {
        scheduledBreaks.ResetSession("UI");
        return Task.CompletedTask;
    }
}
