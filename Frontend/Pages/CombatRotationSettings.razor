@page "/combat-rotation"

@using Core.CombatRotation
@using Core.FeatureFlags

@inject FeatureFlagService featureFlags
@inject CombatRotationAdminService combatRotationAdmin

<PageTitle>Combat Rotation Optimizer</PageTitle>

<h3>Combat Rotation Optimizer</h3>

<div class="alert alert-secondary small">
    The combat rotation optimizer is opt-in and disabled by default.
    It reorders ability priority lists using weighted scoring based on live game state.
    Settings persist to <code>runtime_feature_flags.json</code> and apply immediately.
</div>

<Card class="mt-2">
    <CardHeader>Status</CardHeader>
    <CardBody>
        <dl class="row mb-0">
            <dt class="col-sm-4">Enabled</dt>
            <dd class="col-sm-8">
                <b>@(featureFlags.Current.CombatRotationOptimizer.Enabled ? "On" : "Off")</b>
            </dd>

            <dt class="col-sm-4">Fallback Mode</dt>
            <dd class="col-sm-8">
                @(featureFlags.Current.CombatRotationOptimizer.FallbackToStaticPriority
                    ? "Static priority fallback active"
                    : "Pure optimizer mode")
            </dd>

            <dt class="col-sm-4">Metrics</dt>
            <dd class="col-sm-8">
                @(featureFlags.Current.CombatRotationOptimizer.EnableMetrics ? "Collecting" : "Disabled")
            </dd>
        </dl>
    </CardBody>
</Card>

<Card class="mt-2">
    <CardHeader>Configuration</CardHeader>
    <CardBody>
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="crEnabled"
                   @bind="enabled" />
            <label class="form-check-label" for="crEnabled">Enable Combat Rotation Optimizer</label>
        </div>

        <hr class="my-3" />

        <h5>Core Settings</h5>
        <div class="row g-3">
            <div class="col-md-4">
                <div class="form-check form-switch mt-1">
                    <input class="form-check-input" type="checkbox" role="switch" id="crFallback"
                           @bind="fallbackToStaticPriority" />
                    <label class="form-check-label" for="crFallback">
                        Fallback to Static Priority
                        <small class="text-muted d-block">
                            Revert to original ordering if optimizer errors
                        </small>
                    </label>
                </div>
            </div>
            <div class="col-md-4">
                <label class="form-label">Base Weight Multiplier</label>
                <input class="form-control" type="number" step="0.1" min="0.1" max="10.0"
                       @bind="baseWeightMultiplier" />
                <small class="text-muted">Global multiplier applied to all ability weights</small>
            </div>
        </div>

        <hr class="my-3" />

        <h5>Advanced Features</h5>
        <div class="row g-3">
            <div class="col-md-4">
                <div class="form-check form-switch mt-1">
                    <input class="form-check-input" type="checkbox" role="switch" id="crForecasting"
                           @bind="enableResourceForecasting" />
                    <label class="form-check-label" for="crForecasting">
                        Resource Forecasting
                        <small class="text-muted d-block">
                            Project resource levels at GCD end
                        </small>
                    </label>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-check form-switch mt-1">
                    <input class="form-check-input" type="checkbox" role="switch" id="crSwingTimer"
                           @bind="enableSwingTimerAlignment" />
                    <label class="form-check-label" for="crSwingTimer">
                        Swing Timer Alignment
                        <small class="text-muted d-block">
                            Align instant casts with melee swing timer
                        </small>
                    </label>
                </div>
            </div>
        </div>

        <hr class="my-3" />

        <h5>Metrics</h5>
        <div class="row g-3">
            <div class="col-md-3">
                <div class="form-check form-switch mt-1">
                    <input class="form-check-input" type="checkbox" role="switch" id="crMetrics"
                           @bind="enableMetrics" />
                    <label class="form-check-label" for="crMetrics">Enable Metrics</label>
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label">Flush Interval (sec)</label>
                <input class="form-control" type="number" min="5" max="300"
                       @bind="metricsFlushIntervalSeconds" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Metrics Output Path</label>
                <input class="form-control" type="text" @bind="metricsOutputPath" />
            </div>
        </div>

        <hr class="my-3" />

        <div class="d-flex gap-2">
            <button class="btn btn-primary btn-sm" @onclick="Save">Save</button>
            <button class="btn btn-outline-secondary btn-sm" @onclick="Reset">Reset to Defaults</button>
        </div>

        @if (showSaved)
        {
            <div class="alert alert-success mt-2 small py-1 px-2">Settings saved.</div>
        }
    </CardBody>
</Card>

@code {
    private bool enabled;
    private bool fallbackToStaticPriority;
    private float baseWeightMultiplier;
    private bool enableMetrics;
    private bool enableResourceForecasting;
    private bool enableSwingTimerAlignment;
    private int metricsFlushIntervalSeconds;
    private string metricsOutputPath = string.Empty;
    private bool showSaved;

    protected override void OnInitialized()
    {
        LoadFromCurrent();
    }

    private void LoadFromCurrent()
    {
        CombatRotationOptimizerOptions opts = featureFlags.Current.CombatRotationOptimizer;
        enabled = opts.Enabled;
        fallbackToStaticPriority = opts.FallbackToStaticPriority;
        baseWeightMultiplier = opts.BaseWeightMultiplier;
        enableMetrics = opts.EnableMetrics;
        enableResourceForecasting = opts.EnableResourceForecasting;
        enableSwingTimerAlignment = opts.EnableSwingTimerAlignment;
        metricsFlushIntervalSeconds = opts.MetricsFlushIntervalSeconds;
        metricsOutputPath = opts.MetricsOutputPath;
    }

    private void Save()
    {
        CombatRotationOptimizerOptions options = new()
        {
            Enabled = enabled,
            FallbackToStaticPriority = fallbackToStaticPriority,
            BaseWeightMultiplier = baseWeightMultiplier,
            EnableMetrics = enableMetrics,
            EnableResourceForecasting = enableResourceForecasting,
            EnableSwingTimerAlignment = enableSwingTimerAlignment,
            MetricsFlushIntervalSeconds = metricsFlushIntervalSeconds,
            MetricsOutputPath = metricsOutputPath
        };

        combatRotationAdmin.Save(options);
        showSaved = true;
    }

    private void Reset()
    {
        CombatRotationOptimizerOptions defaults = new();
        enabled = defaults.Enabled;
        fallbackToStaticPriority = defaults.FallbackToStaticPriority;
        baseWeightMultiplier = defaults.BaseWeightMultiplier;
        enableMetrics = defaults.EnableMetrics;
        enableResourceForecasting = defaults.EnableResourceForecasting;
        enableSwingTimerAlignment = defaults.EnableSwingTimerAlignment;
        metricsFlushIntervalSeconds = defaults.MetricsFlushIntervalSeconds;
        metricsOutputPath = defaults.MetricsOutputPath;
        showSaved = false;
    }
}
