        }
    }

    private bool TryGetFrameConfigPreview(out DataFrameConfig config, out string error)
    {
        error = string.Empty;
        config = default;

        if (!FrameConfig.Exists())
            return false;

        try
        {
            config = FrameConfig.Load();
            return true;
        }
        catch (Exception ex)
        {
            error = ex.Message;
            return false;
        }
    }
}
