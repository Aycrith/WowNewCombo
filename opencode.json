{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "enabled": true,
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_TOKEN}"
      }
    }
  },
  "instructions": ["AGENTS.md"],
  "watcher": {
    "ignore": [
      "bin/**",
      "obj/**",
      "Json/mpq/**",
      "Navigation/**",
      "*.log",
      ".git/**"
    ]
  }
}
